# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Sanity CMS Content Lake Integration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your_sanity_api_write_token"
SANITY_API_VERSION="2024-03-01"

# ---------------------------------------------------------------
# Sanity Context MCP (Path One)
# Org ID: Sanity Manage > Organization settings
# Token: Manage > API > Tokens (ORGANIZATION level, Context Viewer role).
#        A project token is refused with 403 contextGrantRequired.
# ---------------------------------------------------------------
SANITY_ORG_ID="your_org_id"
SANITY_CONTEXT_TOKEN="your_org_context_viewer_token"
# Endpoint names as created in the Context app (dataset endpoint + Knowledge Base endpoint)
SANITY_MCP_GRAPH_NAME="chronograph-graph"
SANITY_MCP_DOCS_NAME="chronograph-docs"
# If you could only create the Knowledge Base endpoint (not the dataset one),
# set this to true so the agent runs docs-only instead of failing:
# SANITY_MCP_GRAPH_DISABLED="true"
# Optional: full URL overrides
# SANITY_MCP_GRAPH_URL=""
# SANITY_MCP_DOCS_URL=""
GEMINI_MODEL="gemini-2.5-flash"

# Studio / CLI (schema deploy)
SANITY_STUDIO_PROJECT_ID="your_sanity_project_id"
SANITY_STUDIO_DATASET="production"
